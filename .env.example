# Younify Worker Configuration
# =============================
# Copy this to .env in the project root and fill in your values.
# The worker reads these at startup.

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Ollama (local) ─────────────────────────────────────────────────────
# Set if your Ollama server is NOT on localhost:11434
# OLLAMA_BASE_URL=http://192.168.1.50:11434

# ── OpenRouter ─────────────────────────────────────────────────────────
# Required for OpenRouter. Get your key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── OpenAI ─────────────────────────────────────────────────────────────
# Required for OpenAI. Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# ── vLLM (local) ───────────────────────────────────────────────────────
# Set if your vLLM server is NOT on localhost:8000
# VLLM_BASE_URL=http://localhost:8000
# VLLM_API_KEY=          # usually empty for local vLLM
